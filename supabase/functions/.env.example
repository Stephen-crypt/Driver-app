# Server-side secrets for Edge Functions. Copy to .env and fill in.
#
# Nothing here may ever reach the app bundle. A key shipped in an APK can be
# extracted from it in minutes and spent by anyone who does.
#
# Local:  this file is read by `supabase start`.
# Cloud:  set the same names with
#           supabase secrets set NAME=value --project-ref <ref>

# Geoapify (OpenStreetMap). Used by functions/route for road distance, time
# and shape, and by functions/places for search and pickup names. Free plan:
# 3,000 requests a day, commercial use allowed.
GEOAPIFY_KEY=

# Google Directions API. functions/route asks it only when Geoapify cannot
# answer. Optional. Restrict this key to the Directions API only.
GOOGLE_DIRECTIONS_KEY=

# SMS Gate: an Android phone with a local SIM sends the sign-in codes. The
# username and password appear in the app's Cloud Server section once it is
# online. When both are set, codes go this way and Pindo is not used.
SMSGATE_USERNAME=
SMSGATE_PASSWORD=

# Who gets a text when someone presses SOS (functions/sos-text), comma-
# separated, local or international: 0790803794,+250788123456. The control
# room still shows every alert; this is for when nobody has it open.
SOS_ALERT_PHONES=

# Pindo SMS, for when volume calls for a registered sender name. Token from
# the Pindo dashboard; sender ID must be one you have registered there
# (Configurations -> Sender IDs).
PINDO_API_TOKEN=
PINDO_SENDER_ID=Nova

# Generated by Supabase when the Send SMS hook is created:
#   Authentication -> Hooks -> Send SMS -> HTTPS
# Arrives in the form `v1,whsec_...`; paste it whole.
SEND_SMS_HOOK_SECRET=
