# Server-side secrets for Edge Functions. Copy to .env and fill in.
#
# Nothing here may ever reach the app bundle. A key shipped in an APK can be
# extracted from it in minutes and spent by anyone who does.
#
# Local:  this file is read by `supabase start`.
# Cloud:  set the same names with
#           supabase secrets set NAME=value --project-ref <ref>

# Google Directions API. Used by functions/route to measure real road distance
# for quoting. Restrict this key to the Directions API only.
GOOGLE_DIRECTIONS_KEY=

# Pindo SMS. Token from the Pindo dashboard; sender ID must be one you have
# registered there (Configurations -> Sender IDs).
PINDO_API_TOKEN=
PINDO_SENDER_ID=Gera

# Generated by Supabase when the Send SMS hook is created:
#   Authentication -> Hooks -> Send SMS -> HTTPS
# Arrives in the form `v1,whsec_...`; paste it whole.
SEND_SMS_HOOK_SECRET=
