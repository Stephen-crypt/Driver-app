{
  "expo": {
    "name": "Nova Rider",
    "slug": "nova-rider",
    "scheme": "novarider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F7FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "rw.nova.rider",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nova Rider uses your location to send you trips nearby and guide you to your passenger.",
        "UIBackgroundModes": [
          "location"
        ],
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "rw.nova.rider",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F4C20D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Nova Rider uses your location to send you trips nearby."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A2342"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nova Rider uses the camera to scan rider and vehicle QR codes during safety inspections.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FA",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A1220"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f603c54-2c98-45f2-923b-1978cd16086c"
      }
    },
    "owner": "stephen3000"
  }
}
